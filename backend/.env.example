# Backend Environment Configuration Example
# Copy this to backend/.env and replace placeholders with your actual values

# Gemini API key from Google AI Studio
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model identifier (available in your Google AI Studio project)
LLM_MODEL=gemini-2.5-flash

# Allowed Frontend Origins (comma-separated if multiple)
FRONTEND_ORIGIN=http://localhost:5173

# Server settings
HOST=127.0.0.1
PORT=8000

# Fetcher limits
MAX_SOURCES=10
REQUEST_TIMEOUT_SECONDS=15
MAX_CONTENT_BYTES=2097152
MAX_TEXT_PER_SOURCE=12000

